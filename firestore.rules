rules_version = '2';
// ===================================================================
// REGLAS DE SEGURIDAD DE FIRESTORE PARA CLICMASTER
// Copiar en: Firebase Console > Firestore Database > Reglas > Publicar.
//
// La página NUNCA lee ni escribe Firestore directamente: todo pasa por el
// servidor (Vercel), que usa una clave de servidor y no depende de estas
// reglas. Por eso se bloquea TODO acceso desde navegadores.
// ===================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
